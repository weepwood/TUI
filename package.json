{
  "name": "terminal-ui",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "description": "Weepwood UI — 可配置的 React 通用组件库与设计系统",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "test:lib": "node --test scripts/*.test.mjs",
    "check": "npm run build && npm run build:lib && npm run test:lib"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
